# cookie-web configuration — copy to .env and adjust.

# Server
COOKIE_HOST=0.0.0.0                   # all interfaces; 127.0.0.1 = this machine only
COOKIE_PORT=8765
# COOKIE_API_KEY=change-me            # programs: "Authorization: Bearer <key>"; also the website password — set it on a VPS!
# COOKIE_PASSWORD=                    # a separate website password (the API key still works for programs)
# COOKIE_CORS_ORIGINS=*               # comma-separated origins
COOKIE_MAX_CONCURRENT=1
# COOKIE_MAX_QUEUE=25            # jobs allowed to wait; beyond that 503 + Retry-After
# COOKIE_WATCH_URL=http://127.0.0.1:8790   # send heartbeats to the watchdog (cookie-watch)
COOKIE_REPORTS_DIR=reports

# Model (Ollama)
OLLAMA_HOST=http://127.0.0.1:11434
COOKIE_MODEL=qwen3:4b-instruct       # see docs/HARDWARE.md before changing
COOKIE_FAST_MODEL=qwen3:1.7b          # small jobs (triage, rewrites, fact checks); "none" = main model only. ~1.8 GB RAM
COOKIE_FAST_NUM_CTX=4096
COOKIE_THINK=false
COOKIE_NUM_CTX=8192                   # 16384 on 16 GB boxes
# COOKIE_NUM_THREAD=3                 # cap the model's CPU threads (default: all cores)
COOKIE_TEMPERATURE=0.3
COOKIE_KEEP_ALIVE=-1                  # -1 = keep the model loaded forever
COOKIE_WARMUP=true                    # load the model at startup
COOKIE_AGENT_MODE=pipeline            # pipeline: one main-model call per answer | agent: the model may run extra tool rounds (slower)

# Search backends (all optional; DuckDuckGo, Bing and Mojeek need no key)
# SEARXNG_URL=http://localhost:8888
# BRAVE_API_KEY=
# TAVILY_API_KEY=
# OLLAMA_API_KEY=
COOKIE_SEARCH_MODE=fallback           # fallback | fusion
COOKIE_DISABLE_SCRAPERS=false        # true = only use the configured APIs / SearXNG

# Fetching
COOKIE_FETCH_TIMEOUT_SECS=20
COOKIE_MAX_PAGE_BYTES=6291456
COOKIE_ALLOW_PRIVATE_URLS=false
# COOKIE_USER_AGENT=...
COOKIE_ARCHIVE_FALLBACK=true          # read dead/blocked pages from the Wayback Machine

# Reliability
COOKIE_JOB_TIMEOUT_SECS=1800          # hard limit per job
COOKIE_TIME_SCALE=1.0                 # scale research time budgets (2 = slow CPU, 0.5 = GPU)
COOKIE_FACT_CHECK=true                # check name-linking statements against the sources

# Logging
RUST_LOG=cookie_web=info
