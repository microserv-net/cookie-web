# cookie-web configuration — copy to .env and adjust.

# Server
COOKIE_HOST=127.0.0.1
COOKIE_PORT=8765
# COOKIE_API_KEY=change-me            # require "Authorization: Bearer <key>" on /api/*
# COOKIE_CORS_ORIGINS=*               # comma-separated origins
COOKIE_MAX_CONCURRENT=2
COOKIE_REPORTS_DIR=reports

# Model (Ollama)
OLLAMA_HOST=http://127.0.0.1:11434
COOKIE_MODEL=qwen3:8b
# COOKIE_FAST_MODEL=qwen3:1.7b        # cheaper model for triage / planning / notes
COOKIE_THINK=false
COOKIE_NUM_CTX=16384
COOKIE_TEMPERATURE=0.3
COOKIE_KEEP_ALIVE=10m

# Search backends (all optional; DuckDuckGo + Mojeek need no key)
# SEARXNG_URL=http://localhost:8888
# BRAVE_API_KEY=
# TAVILY_API_KEY=
# OLLAMA_API_KEY=
COOKIE_SEARCH_MODE=fallback           # fallback | fusion
COOKIE_DISABLE_DUCKDUCKGO=false

# Fetching
COOKIE_FETCH_TIMEOUT_SECS=20
COOKIE_MAX_PAGE_BYTES=6291456
COOKIE_ALLOW_PRIVATE_URLS=false
# COOKIE_USER_AGENT=...

# Logging
RUST_LOG=cookie_web=info
