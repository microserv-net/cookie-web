[Unit]
Description=cookie-web research agent
After=network-online.target ollama.service
Wants=network-online.target ollama.service

[Service]
User=cookie
EnvironmentFile=/etc/cookie-web.env
WorkingDirectory=/var/lib/cookie-web
ExecStart=/usr/local/bin/cookie-web serve
Restart=always
RestartSec=5
# cookie-web finishes or drops open streams within 10 s of SIGTERM
TimeoutStopSec=20
# cookie-web itself needs ~20 MB; the model lives in the Ollama process.
MemoryMax=256M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/cookie-web

[Install]
WantedBy=multi-user.target
