# /etc/cookie-web.env — read by deploy/cookie-web.service
COOKIE_HOST=0.0.0.0
COOKIE_PORT=8765
COOKIE_API_KEY=change-me
# COOKIE_PASSWORD=          # website sign-in (defaults to the API key)
COOKIE_MODEL=qwen3:4b-instruct
COOKIE_FAST_MODEL=qwen3:1.7b
COOKIE_NUM_CTX=8192
COOKIE_KEEP_ALIVE=-1
COOKIE_MAX_CONCURRENT=1
COOKIE_MAX_QUEUE=25
COOKIE_AGENT_MODE=pipeline
COOKIE_REPORTS_DIR=/var/lib/cookie-web/reports
OLLAMA_HOST=http://127.0.0.1:11434
# SEARXNG_URL=http://127.0.0.1:8888
RUST_LOG=cookie_web=info
